{
  "name": "youtube-controller-extension",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:prod": "vite build --mode production",
    "package": "rm -f ./dist/build.zip && cd ./dist && zip -r build.zip . -x build.zip",
    "start": "vite build --watch --mode development",
    "start:prod": "vite build --watch --mode production",
    "lint": "eslint ./src --fix",
    "format": "prettier --write ./src ./public ./vite.config.js"
  },
  "devDependencies": {
    "@types/chrome": "0.2.5",
    "eslint": "7.31.0",
    "eslint-plugin-wc": "1.3.1",
    "prettier": "3.9.6",
    "sass": "^1.77.8",
    "vite": "7.2.1"
  },
  "dependencies": {}
}
