{
  "name": "youtube-controller-extension",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:prod": "vite build --mode production",
    "package": "rm -f ./dist/build.zip && cd ./dist && zip -r build.zip . -x build.zip",
    "start": "vite build --watch --mode development",
    "start:prod": "vite build --watch --mode production",
    "lint": "eslint . --fix",
    "format": "prettier --write ./src ./public ./vite.config.js ./eslint.config.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/chrome": "0.2.5",
    "eslint": "10.8.1",
    "eslint-plugin-wc": "3.1.0",
    "globals": "16.5.0",
    "prettier": "3.9.6",
    "sass": "1.77.8",
    "vite": "7.2.1"
  },
  "dependencies": {}
}
